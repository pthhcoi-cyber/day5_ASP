@model IEnumerable<day5_ASP.Models.Category>

@{
    ViewData["Title"] = "Danh Sách Mặt Hàng";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalItems = ViewBag.TotalItems ?? 0;
    string searchString = ViewBag.SearchString ?? "";
}

<h1>Danh Sách Mặt Hàng</h1>

<form asp-action="Index" method="get">
    <p>
        <input type="text" name="searchString"
               value="@searchString"
               style="width: 500px;"
               style="margin-bottom: 10px;"
               placeholder="Nhập tên hoặc mô tả Category..." />
        <input type="submit" value="Tìm kiếm" />
        <input type="submit" value="Làm mới" />
    </p>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details"
                       asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete"
                       asp-route-id="@item.Id">Delete</a> |
                    <a asp-controller="Product"
                       asp-action="Index"
                       asp-route-categoryId="@item.Id">View Products</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p>
    Tổng số Category: @totalItems
</p>

<nav>
    <ul class="pagination">
        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(currentPage - 1)"
               asp-route-searchString="@searchString">
                Previous
            </a>
        </li>

        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == currentPage ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-searchString="@searchString">
                    @i
                </a>
            </li>
        }

        <li class="page-item @(currentPage == totalPages || totalPages == 0 ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(currentPage + 1)"
               asp-route-searchString="@searchString">
                Next
            </a>
        </li>
    </ul>
</nav>
