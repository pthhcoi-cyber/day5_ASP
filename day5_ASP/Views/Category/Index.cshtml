@model IEnumerable<day5_ASP.Models.Category>


@{
    ViewData["Title"] = "Danh sách Category";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalItems = ViewBag.TotalItems ?? 0;
    string searchString = ViewBag.SearchString ?? "";
}


<h2>Danh sách Category</h2>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-5">
            <input type="text"
                   name="searchString"
                   value="@searchString"
                   class="form-control"
                   placeholder="Nhập tên hoặc mô tả Category..." />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary">
                Tìm kiếm
            </button>
        </div>

        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-secondary">
                Làm mới
            </a>
        </div>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-secondary">
        + Thêm Category
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm">
                        Edit
                    </a>|

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm">
                        Details
                    </a>|

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn  btn-sm">
                        Delete
                    </a>|

                    <a asp-controller="Product"
                       asp-action="Index"
                       asp-route-categoryId="@item.Id"
                       class="btn  btn-sm">
                        View Products
                    </a>
                </td>
            </tr>
        }

        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center">
                    Không tìm thấy Category nào!
                </td>
            </tr>
        }
    </tbody>
</table>

<p>
    Tổng số Category: <strong>@totalItems</strong>
</p>


<!-- PHÂN TRANG -->
@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">

            <!-- Previous -->
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link text-secondary"
                   asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-searchString="@searchString">
                    Previous
                </a>
            </li>

            <!-- Trang 1, 2, 3... -->
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item">
                    <a class="page-link @(i == currentPage ? "bg-secondary text-white border-secondary" : "text-secondary")"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchString="@searchString">
                        @i
                    </a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link text-secondary"
                   asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-searchString="@searchString">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}

